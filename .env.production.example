# Set these values in the hosting provider's encrypted environment settings. Never commit a real .env file.
APP_ENV=production
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters-long
CORS_ORIGINS=https://milterra.in,https://www.milterra.in
INIT_DB_ON_STARTUP=false
MQTT_BROKER_HOST=
SMS_PROVIDER=msg91
SMS_API_KEY=
SMS_SENDER_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
S3_BUCKET=
