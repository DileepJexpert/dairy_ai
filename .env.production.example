# Set these values in the hosting provider's encrypted environment settings. Never commit a real .env file.
APP_ENV=production
PRELAUNCH_MODE=false
SHIPPING_ORIGIN_PINCODE=201305
SHIPPING_AUTO_BOOK_ENABLED=false
COMMERCE_PAYMENT_LINK_EXPIRY_MINUTES=30
COMMERCE_UNPAID_ORDER_TTL_HOURS=24
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
REDIS_URL=rediss://USER:PASSWORD@HOST:PORT/0
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters-long
CORS_ORIGINS=https://milterra.in,https://www.milterra.in
INIT_DB_ON_STARTUP=false
ALLOW_DEMO_LOGIN=false
STOREFRONT_BASE_URL=https://milterra.in
PRODUCT_MEDIA_DIR=/app/storage/product-media
MQTT_BROKER_HOST=
SMS_PROVIDER=msg91
SMS_API_KEY=
SMS_SENDER_ID=
SMS_TEMPLATE_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
S3_BUCKET=
