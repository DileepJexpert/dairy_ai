# Flutter shell and the catalogue pointer must see new deployments promptly.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/index.html
  Cache-Control: no-cache, must-revalidate

/
  Cache-Control: no-cache, must-revalidate

/flutter_bootstrap.js
  Cache-Control: no-cache, must-revalidate

/main.dart.js
  Cache-Control: no-cache, must-revalidate

/catalogue/current.json
  Cache-Control: no-cache, must-revalidate

# Published catalogue snapshots have content-derived hash filenames.
/catalogue/products-*.json
  Cache-Control: public, max-age=31536000, immutable

# CanvasKit WASM Engine (Heavy payload, heavily cacheable)
/canvaskit/*
  Cache-Control: public, max-age=31536000, immutable

# Static Store Assets (Images, Icons, Visuals)
/assets/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# Fonts (Cormorant, MaterialIcons, CupertinoIcons)
/*.ttf
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# Favicon and App Icons
/icons/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
